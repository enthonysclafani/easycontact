# PHPStan level 8 with WordPress stubs (szepeviktor/phpstan-wordpress, loaded by the extension installer).
# phpstan-baseline.neon holds the errors of the code that predates the standards (point 0.9 of
# docs/piano-standard.md), generated by CI on 13 October 2026: new errors fail. Fixing one means removing it there.
includes:
	- phpstan-baseline.neon

parameters:
	level: 8
	# The declared minimum: the same result on every PHP version CI runs.
	phpVersion: 80100
	paths:
		- easycontact.php
		- uninstall.php
		- src
		- includes
		- tools
	excludePaths:
		- includes/vendor
		- includes/data
		- tests/fixtures
		- tools/phpstan
		- tools/phone-build
	treatPhpDocTypesAsCertain: false
