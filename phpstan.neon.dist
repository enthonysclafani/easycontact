# PHPStan level 8 with WordPress stubs (szepeviktor/phpstan-wordpress, loaded by the extension installer).
# No baseline: every error fails (point 6.1 of docs/piano-standard.md).

parameters:
	level: 8
	# The declared minimum: the same result on every PHP version CI runs.
	phpVersion: 80100
	paths:
		- easycontact.php
		- uninstall.php
		- src
		- includes
		- tools
	excludePaths:
		# Bundled libraries are not analysed, but their classes stay known to the code that uses them.
		analyse:
			- includes/vendor
		analyseAndScan:
			- includes/data
			- tests/fixtures
			- tools/phpstan
			- tools/phone-build
	treatPhpDocTypesAsCertain: false
