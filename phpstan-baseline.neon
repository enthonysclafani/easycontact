parameters:
	ignoreErrors:
		-
			message: '#^Method EasyContact\\Submissions\\Endpoint\:\:issue\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Endpoint.php

		-
			message: '#^Method EasyContact\\Submissions\\Endpoint\:\:rest_submit\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Endpoint.php

		-
			message: '#^Method EasyContact\\Submissions\\Endpoint\:\:submit\(\) has parameter \$input with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Endpoint.php

		-
			message: '#^Method EasyContact\\Submissions\\Endpoint\:\:submit\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Endpoint.php

		-
			message: '#^Method EasyContact\\Submissions\\Entries\:\:store\(\) has parameter \$assessment with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Entries.php

		-
			message: '#^Method EasyContact\\Submissions\\Entries\:\:store\(\) has parameter \$definition with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Entries.php

		-
			message: '#^Method EasyContact\\Submissions\\Entries\:\:store\(\) has parameter \$values with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Entries.php

		-
			message: '#^Method EasyContact\\Submissions\\Entries\:\:stores_entries\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Entries.php

		-
			message: '#^Method EasyContact\\Submissions\\Entries\:\:stores_quarantine\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Entries.php

		-
			message: '#^Method EasyContact\\Submissions\\State\:\:read\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/State.php

		-
			message: '#^Method EasyContact\\Submissions\\State\:\:write\(\) has parameter \$data with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/State.php

		-
			message: '#^Parameter \#3 \$expiration of function set_transient expects int, float\|int\<1, max\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Submissions/State.php

		-
			message: '#^Action callback returns bool\|WP_Error\|null but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Argument of an invalid type array\<int\|WP_Post\>\|null supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Cannot cast int\|WP_Post to int\.$#'
			identifier: cast.int
			count: 2
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:definition_hash\(\) has parameter \$definition with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:process\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:process\(\) has parameter \$definition with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:process\(\) has parameter \$values with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:process\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:retry\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:retry\(\) should return bool\|WP_Error\|null but empty return statement found\.$#'
			identifier: return.empty
			count: 3
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:schedule\(\) has parameter \$job with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:schedule\(\) has parameter \$outcomes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:send\(\) has parameter \$definition with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:send\(\) has parameter \$values with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:send\(\) should return string but returns int\|string\.$#'
			identifier: return.type
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Method EasyContact\\Submissions\\Submission\:\:status\(\) has parameter \$outcomes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Parameter \#1 \$array of function end expects array\|object, array\<int\|WP_Post\>\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Parameter \#1 \$post_id of function get_post_meta expects int, int\|WP_Post given\.$#'
			identifier: argument.type
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Parameter \#1 \$value of function count expects array\|Countable, array\<int\|WP_Post\>\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Parameter \#2 \$data of function hash_hmac expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Result of \|\| is always true\.$#'
			identifier: booleanOr.alwaysTrue
			count: 1
			path: src/Submissions/Submission.php

		-
			message: '#^Strict comparison using \=\=\= between null and null will always evaluate to true\.$#'
			identifier: identical.alwaysTrue
			count: 1
			path: src/Submissions/Submission.php
