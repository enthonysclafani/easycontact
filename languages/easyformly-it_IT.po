#. Plugin Name of the plugin
#: easyformly.php
msgid "EasyFormly"
msgstr "EasyFormly"

#. Description of the plugin
#: easyformly.php
msgid "Contact forms with local anti-spam, international phone numbers, conditional fields, MailerLite, Slack and Turnstile."
msgstr "Moduli con anti-spam locale, telefoni internazionali, campi condizionali, MailerLite, Slack e Turnstile."

#: src/Admin/Admin.php:37
#: src/Admin/Admin.php:76
msgid "Support"
msgstr "Supporto"

#: src/Admin/Admin.php:59
msgid "Option 1"
msgstr "Opzione 1"

#: src/Admin/Admin.php:60
msgid "Option 2"
msgstr "Opzione 2"

#: src/Admin/Admin.php:77
msgid "Syntax and examples"
msgstr "Sintassi ed esempi"

#: src/Admin/Admin.php:78
msgid "Separate fields on the same line with | to place them in equal-width columns. Start a new line for a new row. An asterisk makes the field required. Save the form to update the fields available in the rules."
msgstr "Separa i campi sulla stessa riga con | per affiancarli in colonne di uguale larghezza. Vai a capo per iniziare una nuova riga. L’asterisco rende il campo obbligatorio. Salva il modulo per aggiornare i campi disponibili nelle regole."

#: src/Admin/Admin.php:79
msgid "Two columns (50% each):"
msgstr "Due colonne (50% ciascuna):"

#. translators: Example form syntax: translate only the labels in quotes.
#: src/Admin/Admin.php:80
msgid "[text* name \"Name\"] | [email* email \"Email\"]"
msgstr "[text* nome \"Nome\"] | [email* email \"Email\"]"

#. translators: Example form syntax: translate only the labels in quotes.
#: src/Admin/Admin.php:81
msgid "Three columns (33.33% each):"
msgstr "Tre colonne (33,33% ciascuna):"

#. translators: Example form syntax: translate only the labels in quotes.
#: src/Admin/Admin.php:82
msgid "[text* name \"Name\"] | [text* surname \"Surname\"] | [email* email \"Email\"]"
msgstr "[text* nome \"Nome\"] | [text* cognome \"Cognome\"] | [email* email \"Email\"]"

#. translators: Example form syntax: translate only the labels in quotes.
#: src/Admin/Admin.php:83
msgid "Widths account for the space between columns. On small screens fields stack vertically. Notes and the button must stay on their own line."
msgstr "Le larghezze tengono conto dello spazio tra le colonne. Su schermi piccoli i campi si dispongono uno sotto l’altro. Note e pulsante devono restare separati."

#. translators: Example form syntax, one tag per line: translate only the labels in quotes.
#: src/Admin/Admin.php:84
msgid ""
"[select reason \"Reason\" \"Information\" \"Quote\"]\n"
"[number budget \"Budget\" min:0 max:100000 step:1]\n"
"[checkbox newsletter \"I would like to receive the newsletter\"]\n"
"[acceptance* privacy \"I have read the privacy policy\"]\n"
"[note \"A short hint\"]\n"
"[submit \"Send\"]"
msgstr "[select motivo \"Motivo\" \"Informazioni\" \"Preventivo\"]\n[number budget \"Budget\" min:0 max:100000 step:1]\n[checkbox newsletter \"Desidero ricevere la newsletter\"]\n[acceptance* privacy \"Ho letto l’informativa privacy\"]\n[note \"Una breve indicazione\"]\n[submit \"Invia\"]"

#. translators: Example form syntax, one tag per line: translate only the labels in quotes.
#: src/Admin/Admin.php:85
msgid ""
"[tel phone \"Phone\"]\n"
"[tel* cell \"Mobile\" mobile country:IT]\n"
"[tel contact \"Contact number\" allow-repeated]"
msgstr "[tel telefono \"Telefono\"]\n[tel* cellulare \"Cellulare\" mobile country:IT]\n[tel recapito \"Recapito\" allow-repeated]"

#. translators: Example form syntax, one tag per line: translate only the labels in quotes.
#: src/Admin/Admin.php:86
msgid "The phone field includes a country selector. country:IT sets the initial country, mobile requires a mobile number and allow-repeated accepts fully repetitive numbers. email, textarea and url are also available. Use unique lowercase names."
msgstr "Il telefono include il selettore del paese. country:IT imposta il paese iniziale del campo, mobile richiede un cellulare e allow-repeated consente numeri interamente ripetitivi. Sono disponibili anche email, textarea e url. Usa nomi unici in minuscolo."

#: src/AntiSpam/AntiSpam.php:114
msgid "Enter at most 30 short phrases, one per line."
msgstr "Inserisci al massimo 30 frasi brevi, una per riga."

#: src/AntiSpam/AntiSpam.php:123
msgid "Each phrase must be 4 to 150 characters long."
msgstr "Ogni frase deve contenere da 4 a 150 caratteri."

